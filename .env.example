# Neon Postgres — connection string usado por Prisma (prisma.config.ts) y por la app.
# Obtenela desde el dashboard de Neon (Connection Details) y cambiá sslmode=require por
# sslmode=verify-full: mantiene la verificación del certificado y evita el warning de pg.
DATABASE_URL=

# Firma las cookies de sesión del login por PIN. Mínimo 32 caracteres, distinto en
# cada entorno. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Integrantes de prueba que crea `npm run seed`, separados por ";" con formato
# Nombre|Apodo|PIN (PIN de 4 números). Para entrar: elegís el apodo y ponés el PIN.
SEED_USUARIOS="Juan Pérez|Juancho|1111;Martín López|Tincho|2222;Facundo Díaz|Facu|3333"

# Cloudflare R2 (fotos de perfil e historias). Bucket privado; ver docs/R2.md para
# crearlo, el token, el CORS y la regla que borra las historias a las 24 hs.
# Sin estas variables la app anda igual, pero sin fotos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hay-estaca
