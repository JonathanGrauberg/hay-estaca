// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoJuntada {
  proxima
  pasada
  archivada
}

enum EstadoAsistencia {
  voy
  no_voy
  en_duda
}

enum TipoChecklistItem {
  grupal
  individual
}

model User {
  id               String    @id @default(cuid())
  nombre           String
  apodo            String
  avatarUrl        String?
  telefono         String?
  fechaNacimiento  DateTime? @db.Date
  // Login por PIN de 4 dígitos: hash scrypt "salt:hash" (lib/auth/pin.ts).
  pinHash          String
  // Después de 5 PINs incorrectos seguidos, el login queda bloqueado unos minutos.
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?
  // Alias o CVU para que le transfieran en las cuentas. Solo lo edita el dueño.
  aliasCvu         String?

  asistencias             Asistencia[]
  checklistItemsAsignados ChecklistItem[]     @relation("ChecklistAsignado")
  gastosPagados           Gasto[]             @relation("GastoPagadoPorUser")
  gastosParticipa         GastoParticipante[]
  bonificaciones          Bonificado[]        @relation("BonificadoUser")
  bonificacionesCubiertas Bonificado[]        @relation("BonificadoCubiertoPor")
  juntadasAnfitrion       Juntada[]           @relation("JuntadaAnfitrion")
  invitadosTraidos        Invitado[]          @relation("InvitadoTraidoPor")
}

model Juntada {
  id          String        @id @default(cuid())
  nombre      String
  fecha       DateTime      @db.Date
  hora        String
  ubicacion   String
  mensajeFomo String?
  // Próxima/pasada se calcula por la fecha; el estado solo importa para "archivada".
  estado      EstadoJuntada @default(proxima)
  // Quién la organiza o pone la casa (para las estadísticas de anfitrión).
  anfitrionId String?
  createdAt   DateTime      @default(now())

  anfitrion      User?           @relation("JuntadaAnfitrion", fields: [anfitrionId], references: [id], onDelete: SetNull)
  invitados      Invitado[]
  asistencias    Asistencia[]
  checklistItems ChecklistItem[]
  gastos         Gasto[]
  bonificados    Bonificado[]

  @@index([estado])
  @@index([fecha])
}

// Alguien de afuera del grupo que va a una juntada puntual (amigo, familiar). Solo
// nombre, sin login: participa de cuentas y juegos de esa juntada.
model Invitado {
  id          String   @id @default(cuid())
  juntadaId   String
  nombre      String
  traidoPorId String?
  createdAt   DateTime @default(now())

  juntada   Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  traidoPor User?   @relation("InvitadoTraidoPor", fields: [traidoPorId], references: [id], onDelete: SetNull)

  gastosPagados   Gasto[]             @relation("GastoPagadoPorInvitado")
  gastosParticipa GastoParticipante[]
  bonificaciones  Bonificado[]

  @@index([juntadaId])
}

model Asistencia {
  id           String           @id @default(cuid())
  userId       String
  juntadaId    String
  estado       EstadoAsistencia @default(en_duda)
  respondidoAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  juntada Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)

  @@unique([userId, juntadaId])
  @@index([juntadaId])
  @@index([userId])
}

model ChecklistItem {
  id              String            @id @default(cuid())
  juntadaId       String
  descripcion     String
  asignadoAUserId String?
  completado      Boolean           @default(false)
  tipo            TipoChecklistItem @default(grupal)
  createdAt       DateTime          @default(now())

  juntada   Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  asignadoA User?   @relation("ChecklistAsignado", fields: [asignadoAUserId], references: [id], onDelete: SetNull)

  @@index([juntadaId])
  @@index([asignadoAUserId])
}

// Cuentas claras. Una "persona" de una juntada es un integrante (userId) o un
// invitado (invitadoId): en las tablas de abajo va exactamente uno de los dos.
// Los montos van en centavos (Int) para que las cuentas no tengan errores de redondeo.
model Gasto {
  id                  String   @id @default(cuid())
  juntadaId           String
  concepto            String
  montoCentavos       Int
  pagadoPorUserId     String?
  pagadoPorInvitadoId String?
  createdAt           DateTime @default(now())

  juntada           Juntada             @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  pagadoPorUser     User?               @relation("GastoPagadoPorUser", fields: [pagadoPorUserId], references: [id], onDelete: Restrict)
  pagadoPorInvitado Invitado?           @relation("GastoPagadoPorInvitado", fields: [pagadoPorInvitadoId], references: [id], onDelete: Restrict)
  participantes     GastoParticipante[]

  @@index([juntadaId])
  @@index([pagadoPorUserId])
  @@index([pagadoPorInvitadoId])
}

// Entre quiénes se divide un gasto. "Se llevó su bebida" = no está en ese gasto;
// "promo de fernet entre 3" = solo esos 3.
model GastoParticipante {
  id         String  @id @default(cuid())
  gastoId    String
  userId     String?
  invitadoId String?

  gasto    Gasto     @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitado Invitado? @relation(fields: [invitadoId], references: [id], onDelete: Cascade)

  @@unique([gastoId, userId])
  @@unique([gastoId, invitadoId])
  @@index([userId])
  @@index([invitadoId])
}

// Invitado de honor de una juntada (cumpleaños, anda corto): no paga su parte.
// Sin cubiertoPor, su parte de cada gasto se reparte entre los otros participantes;
// con cubiertoPor, la paga esa persona.
model Bonificado {
  id                String  @id @default(cuid())
  juntadaId         String
  userId            String?
  invitadoId        String?
  cubiertoPorUserId String?

  juntada     Juntada   @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  user        User?     @relation("BonificadoUser", fields: [userId], references: [id], onDelete: Cascade)
  invitado    Invitado? @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  cubiertoPor User?     @relation("BonificadoCubiertoPor", fields: [cubiertoPorUserId], references: [id], onDelete: SetNull)

  @@unique([juntadaId, userId])
  @@unique([juntadaId, invitadoId])
}
