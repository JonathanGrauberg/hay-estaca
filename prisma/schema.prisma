// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoJuntada {
  proxima
  pasada
  archivada
}

enum EstadoAsistencia {
  voy
  no_voy
  en_duda
}

// Cuentas de una juntada: se cargan gastos (abiertas), el encargado las divide y
// se van tildando los pagos (divididas), y cuando están todos a mano las cierra.
enum EstadoCuentas {
  abiertas
  divididas
  cerradas
}

enum TipoChecklistItem {
  grupal
  individual
}

model User {
  id               String    @id @default(cuid())
  nombre           String
  apodo            String
  // Ruta de la foto de perfil ("/fotos/avatars/..."), servida por app/fotos.
  avatarUrl        String?
  telefono         String?
  fechaNacimiento  DateTime? @db.Date
  // Login por PIN de 4 dígitos: hash scrypt "salt:hash" (lib/auth/pin.ts).
  pinHash          String
  // Después de 5 PINs incorrectos seguidos, el login queda bloqueado unos minutos.
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?
  // Alias o CVU para que le transfieran en las cuentas. Solo lo edita el dueño.
  aliasCvu         String?
  // Encargado fijo de "la casa de la moneda": queda a cargo de las cuentas de cada
  // juntada a la que confirma que va.
  encargadoCuentas Boolean   @default(false)
  // Admin del grupo: suma y saca integrantes, edita sus datos y les genera PIN nuevo.
  esAdmin          Boolean   @default(false)

  asistencias              Asistencia[]
  checklistItemsAsignados  ChecklistItem[]         @relation("ChecklistAsignado")
  gastosPagados            Gasto[]                 @relation("GastoPagadoPorUser")
  gastosParticipa          GastoParticipante[]
  bonificaciones           Bonificado[]            @relation("BonificadoUser")
  bonificacionesCubiertas  Bonificado[]            @relation("BonificadoCubiertoPor")
  juntadasAnfitrion        Juntada[]               @relation("JuntadaAnfitrion")
  invitadosTraidos         Invitado[]              @relation("InvitadoTraidoPor")
  juntadasEncargado        Juntada[]               @relation("JuntadaEncargadoCuentas")
  categoriasParticipa      CategoriaParticipante[]
  pagosHechos              Pago[]                  @relation("PagoDeUser")
  pagosRecibidos           Pago[]                  @relation("PagoAUser")
  fotosPropuestasRecibidas PropuestaFoto[]         @relation("PropuestaFotoPara")
  fotosPropuestasHechas    PropuestaFoto[]         @relation("PropuestaFotoDe")
  historias                Historia[]
}

model Juntada {
  id                 String        @id @default(cuid())
  nombre             String
  fecha              DateTime      @db.Date
  hora               String
  // Cuándo termina (opcional). Sin esto, se da por terminada 24 hs después de empezar.
  // Hasta ahí se pueden subir historias (lib/juntadas/horario.ts).
  fechaFin           DateTime?     @db.Date
  horaFin            String?
  ubicacion          String
  mensajeFomo        String?
  // Próxima/pasada se calcula por la fecha; el estado solo importa para "archivada".
  estado             EstadoJuntada @default(proxima)
  // Quién la organiza o pone la casa (para las estadísticas de anfitrión).
  anfitrionId        String?
  cuentasEstado      EstadoCuentas @default(abiertas)
  // Quién se hizo cargo de las cuentas. Si es null, queda el primer encargado fijo
  // del grupo que confirmó que va (lib/cuentas/encargado.ts).
  encargadoCuentasId String?
  createdAt          DateTime      @default(now())

  anfitrion        User?           @relation("JuntadaAnfitrion", fields: [anfitrionId], references: [id], onDelete: SetNull)
  encargadoCuentas User?           @relation("JuntadaEncargadoCuentas", fields: [encargadoCuentasId], references: [id], onDelete: SetNull)
  categorias       Categoria[]
  pagos            Pago[]
  historias        Historia[]
  invitados        Invitado[]
  asistencias      Asistencia[]
  checklistItems   ChecklistItem[]
  gastos           Gasto[]
  bonificados      Bonificado[]

  @@index([estado])
  @@index([fecha])
}

// Alguien de afuera del grupo que va a una juntada puntual (amigo, familiar). Solo
// nombre, sin login: participa de cuentas y juegos de esa juntada.
model Invitado {
  id          String   @id @default(cuid())
  juntadaId   String
  nombre      String
  traidoPorId String?
  createdAt   DateTime @default(now())

  juntada   Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  traidoPor User?   @relation("InvitadoTraidoPor", fields: [traidoPorId], references: [id], onDelete: SetNull)

  gastosPagados       Gasto[]                 @relation("GastoPagadoPorInvitado")
  gastosParticipa     GastoParticipante[]
  bonificaciones      Bonificado[]
  categoriasParticipa CategoriaParticipante[]
  pagosHechos         Pago[]                  @relation("PagoDeInvitado")
  pagosRecibidos      Pago[]                  @relation("PagoAInvitado")

  @@index([juntadaId])
}

model Asistencia {
  id           String           @id @default(cuid())
  userId       String
  juntadaId    String
  estado       EstadoAsistencia @default(en_duda)
  respondidoAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  juntada Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)

  @@unique([userId, juntadaId])
  @@index([juntadaId])
  @@index([userId])
}

model ChecklistItem {
  id              String            @id @default(cuid())
  juntadaId       String
  descripcion     String
  asignadoAUserId String?
  completado      Boolean           @default(false)
  tipo            TipoChecklistItem @default(grupal)
  createdAt       DateTime          @default(now())

  juntada   Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  asignadoA User?   @relation("ChecklistAsignado", fields: [asignadoAUserId], references: [id], onDelete: SetNull)

  @@index([juntadaId])
  @@index([asignadoAUserId])
}

// Cuentas claras. Una "persona" de una juntada es un integrante (userId) o un
// invitado (invitadoId): en las tablas de abajo va exactamente uno de los dos.
// Los montos van en centavos (Int) para que las cuentas no tengan errores de redondeo.
model Gasto {
  id                  String   @id @default(cuid())
  juntadaId           String
  concepto            String
  montoCentavos       Int
  pagadoPorUserId     String?
  pagadoPorInvitadoId String?
  // Con categoría, se divide entre los tildados de la categoría; sin categoría,
  // entre los participantes elegidos a mano (promo entre 3, gastos viejos).
  categoriaId         String?
  createdAt           DateTime @default(now())

  juntada           Juntada             @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  pagadoPorUser     User?               @relation("GastoPagadoPorUser", fields: [pagadoPorUserId], references: [id], onDelete: Restrict)
  pagadoPorInvitado Invitado?           @relation("GastoPagadoPorInvitado", fields: [pagadoPorInvitadoId], references: [id], onDelete: Restrict)
  participantes     GastoParticipante[]
  categoria         Categoria?          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@index([juntadaId])
  @@index([categoriaId])
  @@index([pagadoPorUserId])
  @@index([pagadoPorInvitadoId])
}

// Entre quiénes se divide un gasto. "Se llevó su bebida" = no está en ese gasto;
// "promo de fernet entre 3" = solo esos 3.
model GastoParticipante {
  id         String  @id @default(cuid())
  gastoId    String
  userId     String?
  invitadoId String?

  gasto    Gasto     @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitado Invitado? @relation(fields: [invitadoId], references: [id], onDelete: Cascade)

  @@unique([gastoId, userId])
  @@unique([gastoId, invitadoId])
  @@index([userId])
  @@index([invitadoId])
}

// Invitado de honor de una juntada (cumpleaños, anda corto): no paga su parte.
// Sin cubiertoPor, su parte de cada gasto se reparte entre los otros participantes;
// con cubiertoPor, la paga esa persona.
model Bonificado {
  id                String  @id @default(cuid())
  juntadaId         String
  userId            String?
  invitadoId        String?
  cubiertoPorUserId String?

  juntada     Juntada   @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  user        User?     @relation("BonificadoUser", fields: [userId], references: [id], onDelete: Cascade)
  invitado    Invitado? @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  cubiertoPor User?     @relation("BonificadoCubiertoPor", fields: [cubiertoPorUserId], references: [id], onDelete: SetNull)

  @@unique([juntadaId, userId])
  @@unique([juntadaId, invitadoId])
}

// "¿Qué dividimos?": comida, bebida, picada... Cada una con los que participaron.
model Categoria {
  id        String   @id @default(cuid())
  juntadaId String
  nombre    String
  createdAt DateTime @default(now())

  juntada       Juntada                 @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  participantes CategoriaParticipante[]
  gastos        Gasto[]

  @@index([juntadaId])
}

model CategoriaParticipante {
  id          String  @id @default(cuid())
  categoriaId String
  userId      String?
  invitadoId  String?

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitado  Invitado? @relation(fields: [invitadoId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, userId])
  @@unique([categoriaId, invitadoId])
  @@index([userId])
  @@index([invitadoId])
}

// Una transferencia que ya se hizo (el check verde). Se descuenta de los saldos, así
// que las transferencias que faltan se recalculan solas aunque cambie algún gasto.
model Pago {
  id            String   @id @default(cuid())
  juntadaId     String
  deUserId      String?
  deInvitadoId  String?
  aUserId       String?
  aInvitadoId   String?
  montoCentavos Int
  createdAt     DateTime @default(now())

  juntada    Juntada   @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  deUser     User?     @relation("PagoDeUser", fields: [deUserId], references: [id], onDelete: Restrict)
  deInvitado Invitado? @relation("PagoDeInvitado", fields: [deInvitadoId], references: [id], onDelete: Restrict)
  aUser      User?     @relation("PagoAUser", fields: [aUserId], references: [id], onDelete: Restrict)
  aInvitado  Invitado? @relation("PagoAInvitado", fields: [aInvitadoId], references: [id], onDelete: Restrict)

  @@index([juntadaId])
  @@index([deUserId])
  @@index([aUserId])
  @@index([deInvitadoId])
  @@index([aInvitadoId])
}

// Una foto de perfil que alguien le propone a otro: queda pendiente hasta que el
// dueño la acepta (pasa a ser su avatar) o la rechaza (se borra).
model PropuestaFoto {
  id         String   @id @default(cuid())
  paraUserId String
  deUserId   String
  // Clave del objeto en R2 ("avatars/<paraUserId>/<id>.webp").
  key        String
  createdAt  DateTime @default(now())

  para User @relation("PropuestaFotoPara", fields: [paraUserId], references: [id], onDelete: Cascade)
  de   User @relation("PropuestaFotoDe", fields: [deUserId], references: [id], onDelete: Cascade)

  @@index([paraUserId])
}

// Foto de la juntada que dura 24 horas y solo ven los que van. R2 borra el archivo
// solo (regla de vida sobre "historias/") y la app no muestra las de más de 24 hs.
model Historia {
  id        String   @id @default(cuid())
  juntadaId String
  autorId   String
  // Clave del objeto en R2 ("historias/<juntadaId>/<id>.webp").
  key       String
  texto     String?
  // Lo que ven los que no van en vez de la foto (el FOMO). Si ninguna historia lo
  // tiene, se usa el mensajeFomo de la juntada.
  fomo      String?
  createdAt DateTime @default(now())

  juntada Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  autor   User    @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([juntadaId, createdAt])
}
