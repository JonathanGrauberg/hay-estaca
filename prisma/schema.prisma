// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoJuntada {
  proxima
  pasada
  archivada
}

enum EstadoAsistencia {
  voy
  no_voy
  en_duda
}

enum TipoChecklistItem {
  grupal
  individual
}

model User {
  id               String    @id @default(cuid())
  nombre           String
  apodo            String
  avatarUrl        String?
  telefono         String?
  fechaNacimiento  DateTime? @db.Date
  // Login por PIN de 4 dígitos: hash scrypt "salt:hash" (lib/auth/pin.ts).
  pinHash          String
  // Después de 5 PINs incorrectos seguidos, el login queda bloqueado unos minutos.
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  asistencias             Asistencia[]
  checklistItemsAsignados ChecklistItem[]  @relation("ChecklistAsignado")
  gastosComprados         Gasto[]          @relation("GastoComprador")
  gastoExclusiones        GastoExclusion[]
  juntadasAnfitrion       Juntada[]        @relation("JuntadaAnfitrion")
  invitadosTraidos        Invitado[]       @relation("InvitadoTraidoPor")
}

model Juntada {
  id          String        @id @default(cuid())
  nombre      String
  fecha       DateTime      @db.Date
  hora        String
  ubicacion   String
  mensajeFomo String?
  // Próxima/pasada se calcula por la fecha; el estado solo importa para "archivada".
  estado      EstadoJuntada @default(proxima)
  // Quién la organiza o pone la casa (para las estadísticas de anfitrión).
  anfitrionId String?
  createdAt   DateTime      @default(now())

  anfitrion      User?           @relation("JuntadaAnfitrion", fields: [anfitrionId], references: [id], onDelete: SetNull)
  invitados      Invitado[]
  asistencias    Asistencia[]
  checklistItems ChecklistItem[]
  gastos         Gasto[]

  @@index([estado])
  @@index([fecha])
}

// Alguien de afuera del grupo que va a una juntada puntual (amigo, familiar). Solo
// nombre, sin login: participa de cuentas y juegos de esa juntada.
model Invitado {
  id          String   @id @default(cuid())
  juntadaId   String
  nombre      String
  traidoPorId String?
  createdAt   DateTime @default(now())

  juntada   Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  traidoPor User?   @relation("InvitadoTraidoPor", fields: [traidoPorId], references: [id], onDelete: SetNull)

  @@index([juntadaId])
}

model Asistencia {
  id           String           @id @default(cuid())
  userId       String
  juntadaId    String
  estado       EstadoAsistencia @default(en_duda)
  respondidoAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  juntada Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)

  @@unique([userId, juntadaId])
  @@index([juntadaId])
  @@index([userId])
}

model ChecklistItem {
  id              String            @id @default(cuid())
  juntadaId       String
  descripcion     String
  asignadoAUserId String?
  completado      Boolean           @default(false)
  tipo            TipoChecklistItem @default(grupal)
  createdAt       DateTime          @default(now())

  juntada   Juntada @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  asignadoA User?   @relation("ChecklistAsignado", fields: [asignadoAUserId], references: [id], onDelete: SetNull)

  @@index([juntadaId])
  @@index([asignadoAUserId])
}

model Gasto {
  id              String   @id @default(cuid())
  juntadaId       String
  compradorUserId String
  monto           Decimal  @db.Decimal(10, 2)
  concepto        String
  createdAt       DateTime @default(now())

  juntada     Juntada          @relation(fields: [juntadaId], references: [id], onDelete: Cascade)
  comprador   User             @relation("GastoComprador", fields: [compradorUserId], references: [id], onDelete: Restrict)
  exclusiones GastoExclusion[]

  @@index([juntadaId])
  @@index([compradorUserId])
}

model GastoExclusion {
  id      String @id @default(cuid())
  gastoId String
  userId  String

  gasto Gasto @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gastoId, userId])
  @@index([gastoId])
  @@index([userId])
}
